# Copy this file to backend/.env and edit the values.
# Secrets stay ONLY on the backend (never in Flutter).
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/parkkeys_db
TEST_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/parkkeys_test
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=*
ML_REFRESH_MINUTES=30
ML_ENABLED=true
